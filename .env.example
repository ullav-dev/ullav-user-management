# Required — change in production
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/user_management
JWT_SECRET=change_me_to_a_long_random_string

# Optional — defaults shown
ENABLE_DOCS=true   # set to false in production to disable /openapi.yaml, /openapi.json, /docs
# WHITELIST=10.0.0.1,10.0.0.2   # comma-separated IPs allowed to use plain HTTP (localhost always allowed)
# GEOBLOCK=CN,RU,KP             # comma-separated ISO 3166-1 alpha-2 country codes to deny
# GEOIP_DB=/etc/geoip/GeoLite2-Country.mmdb  # required when GEOBLOCK is set
# CORS_ORIGINS=*                # "*" to allow any origin, or comma-separated list e.g. https://app.example.com,https://www.example.com
JWT_TTL_HOURS=24
RESET_TOKEN_TTL_MINUTES=30
CONFIRMATION_TOKEN_TTL_MINUTES=1440
HOST=0.0.0.0
PORT=8081
RUST_LOG=info

# SMTP email — omit SMTP_HOST to disable email sending entirely
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=user@example.com
# SMTP_PASSWORD=secret
# SMTP_FROM=noreply@example.com
# APP_BASE_URL=http://localhost:8081
#
# Multi-tenant: allowlist of app_url values accepted in POST /users and POST /auth/password-reset/request.
# When unset, app_url in request bodies is ignored and APP_BASE_URL is always used (single-tenant mode).
# ALLOWED_APP_URLS=https://app1.example.com,https://app2.example.com/en
#
# For local testing with MailHog (no TLS):
#   docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog
#   SMTP_HOST=localhost SMTP_PORT=1025 SMTP_NO_TLS=true SMTP_FROM=test@example.com APP_BASE_URL=http://localhost:8081
