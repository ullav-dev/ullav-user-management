# Required — change in production
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/user_management
JWT_SECRET=change_me_to_a_long_random_string

# Optional — defaults shown
JWT_TTL_HOURS=24
RESET_TOKEN_TTL_MINUTES=30
CONFIRMATION_TOKEN_TTL_MINUTES=1440
HOST=0.0.0.0
PORT=8081
RUST_LOG=info

# SMTP email — omit SMTP_HOST to disable email sending entirely
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=user@example.com
# SMTP_PASSWORD=secret
# SMTP_FROM=noreply@example.com
# APP_BASE_URL=http://localhost:8081
#
# For local testing with MailHog (no TLS):
#   docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog
#   SMTP_HOST=localhost SMTP_PORT=1025 SMTP_NO_TLS=true SMTP_FROM=test@example.com APP_BASE_URL=http://localhost:8081
